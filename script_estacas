  plot(density(df_poly$r2), main = paste("Densidade R² Polinomial -", alt, "m"), xlab = "R²", lwd = 3, col = "darkred"); dev.off()
  
  # GRÁFICO DE REGRESSÃO
  png(file.path(GRAF_DIR, paste0("regressao_bootstrap_", alt, "m.png")), width = 2000, height = 1500, res = 300)
  
  plot(d_orig$altura_sfm, d_orig$altura_nominal, pch = 16, cex = 1.5, 
       xlab = "Altura Estimada (SfM)", ylab = "Altura Nominal (Real)", 
       main = paste("Regressões Bootstrap -", alt, "m"), 
       xlim = c(min(d_orig$altura_sfm)*0.8, max(d_orig$altura_sfm)*1.2),
       ylim = c(min(d_orig$altura_nominal)*0.8, max(d_orig$altura_nominal)*1.2))
  
  abline(a = mean(df_lin$intercepto), b = mean(df_lin$beta1), col = "blue", lwd = 3, lty = 2)
  
  x_seq <- seq(min(d_orig$altura_sfm), max(d_orig$altura_sfm), length.out = 100)
  y_poly <- mean(df_poly$intercepto) + mean(df_poly$beta1)*x_seq + mean(df_poly$beta2)*(x_seq^2)
  lines(x_seq, y_poly, col = "red", lwd = 3, lty = 1)
  
  legend("topleft", legend = c("Linear (Média)", "Polinomial (Média)"),
         col = c("blue", "red"), lwd = 3, lty = c(2, 1), bty = "n")
  dev.off()
}

