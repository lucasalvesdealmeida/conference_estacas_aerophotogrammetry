calc_boot_metrics <- function(data, R = 10000) {
  n <- nrow(data)
  res_lin <- data.frame(intercepto = numeric(R), beta1 = numeric(R), r2 = numeric(R), rmse = numeric(R))
  res_poly <- data.frame(intercepto = numeric(R), beta1 = numeric(R), beta2 = numeric(R), r2 = numeric(R), rmse = numeric(R))
  
  for (i in 1:R) {
    idx <- sample(1:n, n, replace = TRUE)
    d_boot <- data[idx, ]
    
    # Checagem: se todos os X forem iguais, a variância é 0 e o lm vai falhar
    if (var(d_boot$altura_sfm) == 0) {
      res_lin[i, ] <- NA
      res_poly[i, ] <- NA
      next # Pula para a próxima iteração
    }
    
    # Modelo Linear
    mod_lin <- lm(altura_nominal ~ altura_sfm, data = d_boot)
    res_lin$intercepto[i] <- coef(mod_lin)[1]
    res_lin$beta1[i] <- coef(mod_lin)[2]
    res_lin$r2[i] <- summary(mod_lin)$r.squared
    res_lin$rmse[i] <- sqrt(mean(resid(mod_lin)^2))
    
    # Modelo Polinomial (Grau 2)
    mod_poly <- lm(altura_nominal ~ poly(altura_sfm, 2, raw = TRUE), data = d_boot)
    res_poly$intercepto[i] <- coef(mod_poly)[1]
    res_poly$beta1[i] <- coef(mod_poly)[2]
    res_poly$beta2[i] <- coef(mod_poly)[3]
    res_poly$r2[i] <- summary(mod_poly)$r.squared
    res_poly$rmse[i] <- sqrt(mean(resid(mod_poly)^2))
  }
  return(list(linear = res_lin, poly = res_poly))
}

