# 3. FUNÇÕES AUXILIARES --------------------------------------
carregar_pts <- function(cfg, col_id, col_tipo) {
  pts <- st_read(cfg$shp, quiet = TRUE)
  if (!col_id %in% names(pts)) pts[[col_id]] <- seq_len(nrow(pts))
  if (!col_tipo %in% names(pts)) stop("Coluna '", col_tipo, "' ausente.")
  pts
}

extrair_alturas <- function(cfg, altitude, metodo = "single", buf_m = 0.15,
                            col_id = "id", col_tipo = "tipo") {
  pts <- carregar_pts(cfg, col_id, col_tipo)
  dsm <- terra::rast(cfg$dsm); dem <- terra::rast(cfg$dem)
  if (st_crs(pts) != crs(dsm)) pts <- st_transform(pts, crs(dsm))
  
  ids <- pts[[col_id]]
  tipo_val <- suppressWarnings(as.numeric(as.character(pts[[col_tipo]])))
  n <- length(ids)
  
  if (metodo == "single") {
    pts_v <- terra::vect(pts)
    v_dsm <- terra::extract(dsm, pts_v, ID = FALSE)
    v_dem <- terra::extract(dem, pts_v, ID = FALSE)
    z_dsm <- if (is.data.frame(v_dsm)) v_dsm[[ncol(v_dsm)]] else as.numeric(v_dsm)
    z_dem <- if (is.data.frame(v_dem)) v_dem[[ncol(v_dem)]] else as.numeric(v_dem)
  } else {
    buf_sf <- st_buffer(pts, dist = buf_m)
    buf_v  <- terra::vect(buf_sf)
    z_dsm <- terra::extract(dsm, buf_v, fun = max, na.rm = TRUE, ID = FALSE)[, 1]
    z_dem <- terra::extract(dem, buf_v, fun = min, na.rm = TRUE, ID = FALSE)[, 1]
  }
  
  data.frame(
    id_estaca = ids, altitude = as.numeric(altitude), tipo_cm = tipo_val,
    z_dsm = z_dsm, z_dem = z_dem, altura_sfm = z_dsm - z_dem,
    altura_nominal = tipo_val / 100
  )
}

