  hist(df_lin$beta1, breaks = 50, main = paste("Bootstrap Slope Linear -", alt, "m"), xlab = "Beta", col = "lightgreen", border = "white"); dev.off()
  
  png(file.path(GRAF_DIR, paste0("densidade_r2_linear_", alt, "m.png")), width = 2000, height = 1500, res = 300)
  plot(density(df_lin$r2), main = paste("Densidade R² Linear -", alt, "m"), xlab = "R²", lwd = 3, col = "darkblue"); dev.off()
  
  # HISTOGRAMAS E DENSIDADES (Polinomial)
